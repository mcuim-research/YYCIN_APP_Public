# Copy this file to .env and set your backend URL. Restart Expo after changes.
# EXPO_PUBLIC_* values are included in the app bundle. Never put secrets here.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com/yoyo

# Android Firebase: supply your own android/app/google-services.json locally.
