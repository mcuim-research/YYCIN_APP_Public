# Copy to android/keystore.properties for local release builds. Do not commit it.
# storeFile is relative to android/app, or can be an absolute path.
# Keep the keystore outside the public repository and back it up securely.
storeFile=release.keystore
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=REPLACE_WITH_KEY_ALIAS
keyPassword=REPLACE_WITH_KEY_PASSWORD

# CI can set these environment variables instead (they override local values):
# YYCIN_RELEASE_STORE_FILE
# YYCIN_RELEASE_STORE_PASSWORD
# YYCIN_RELEASE_KEY_ALIAS
# YYCIN_RELEASE_KEY_PASSWORD
